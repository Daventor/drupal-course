<?php

use Drupal\Core\Form\FormStateInterface;

/** 
 * Implements hook_theme()
 */
function developer_directory_theme($existing, $type, $theme, $path): array {
    return [
        'developer_profile' => [
            'variables' => [
                'name' => null,
                'bio' => null,
                'experience' => null,
                'skills' => null,
                'email' => null,
                'available' => false,
                'portfolio_title' => null,
                'portfolio_uri' => null
            ],
            'template' => 'developer-profile'
        ]
    ];
}

/**
 * Implements hook_form_FORM_ID_alter().
 * 
 * Altera el formulario de búsqueda de desarrolladores
 */
function developer_directory_form_developer_directory_search_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
    $route_name = \Drupal::routeMatch()->getRouteName();

    if($route_name !== 'developer_directory.search'){
        return;
    }

    $form['#validate'][] = 'developer_directory_extra_validate';

    // Para añadir un procesamiento adicional
    $form['#submit'][] = 'developer_directory_extra_submit';

    // Modificamos el campo que ya existe del formulario
    $form['name']['#title'] = t('Buscar desarrolladores');

    $form['name']['#description'] = t('Introduce al menos dos caracteres para realizar la búsqueda');

    $form['name']['#attributes']['placeholder'] = t('Ej.: Ana');

    $form['name']['#required'] = true;

    $form['name']['#maxlength'] = 100;

    $form['name']['#element_validate'][] = 'developer_directory_search_name_validate';

    $form['search_help'] = [
        '#type' => 'item',
        '#title' => t('Consejo'),
        '#markup' => t('Puedes buscar por el nombre completo o por una parte del nombre'),
        '#weight' => -10,
    ];

    $form['actions']['submit']['#value'] = t('Buscar desarrolladores');    
}

/**
 * Validación especial para name en el formulario de búsqueda
 */
function developer_directory_search_name_validate(array &$element, FormStateInterface $form_state, array &$form): void{
    $name = trim((string) $element['#value']);

    if(mb_strlen($name) < 2){
        $form_state->setError($element, t('Introduce al menos dos caracteres para buscar'));
    }
}

function developer_directory_extra_validate(array &$form, FormStateInterface $form_state){
    $name = trim((string) $form_state->getValue('name'));

    if(str_contains($name, '@')){
        $form_state->setErrorByName('name', t('La búsqueda no admite @.'));
    }
}

function developer_directory_extra_submit(array &$form, FormStateInterface $form_state){
    \Drupal::logger('developer_directory')->notice('Se ha realizado una búsqueda de desarrolladores');
}