<article class="developer-profile"> 
    <h2>{{ 'Desarrollador: @name'|t({'@name': name}) }}</h2>

    <p> <strong>{% trans %}Bienvenido al directorio de desarrolladores !!{% endtrans %}</strong></p>
    <p>
        <strong>{{ 'Bio'|t }}: </strong> {{ bio }}
    </p>

    {% if portfolio_uri  %}
        <p>
            <strong>Portfolio: </strong> <a href="{{ portfolio_uri}}">{{ portfolio_title|default('Ver portfolio') }}</a>
        </p>
    {% endif %}

    <p>
        <strong>Experience: </strong> {{ experience }}
    </p>    

    {% include '@developer_directory/developer-skills.html.twig' with { technologies: skills } %}

    <p><strong>Disponible: </strong> {{ (available|default(null))?"Sí":"No" }}</p>

    {% if available %}
        <p><strong>Contacto: </strong> <a href="mailto:{{ email }}">{{ email }}</a></p>
    {% endif %}
</article>